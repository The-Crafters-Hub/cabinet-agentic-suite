# ── Gemini API ──────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ── PostgreSQL (Iron Vault) ──────────────────────────────────────
# Constructed automatically from these parts:
POSTGRES_USER=crafter_admin
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=thecraftershub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Meta WhatsApp Business API ───────────────────────────────────
META_ACCESS_TOKEN=your_meta_bearer_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# ── Alert recipient (Hosam) ──────────────────────────────────────
HOSAM_ALERT_PHONE=+201113776666

# ── Output directories ───────────────────────────────────────────
LESSON_GUIDE_DIR=D:\Daily Reports\lesson_guides
